# AI Technical Recruiter — copy to apps/api/.env and apps/web/.env.local

APP_ENV=development
APP_NAME=AI Technical Recruiter
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database — use Postgres+pgvector in Docker/prod; SQLite works for local demo
DATABASE_URL=sqlite+aiosqlite:///./ai_recruiter.db
# DATABASE_URL=postgresql+asyncpg://recruiter:recruiter@localhost:5432/ai_recruiter

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM (OpenAI-compatible; Groq works with base URL)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Reranker
RERANKER_PROVIDER=none

# Voice
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=edge
TTS_VOICE=en-US-JennyNeural

# Observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-technical-recruiter

# Research (optional)
RESEARCH_ENABLED=false
RESEARCH_PROVIDER=none

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=./uploads

# Rate limits
RATE_LIMIT_PER_MINUTE=60

# Demo seed (optional)
DEMO_EMAIL=recruiter@example.com
DEMO_PASSWORD=demo1234
DEMO_NAME=Demo Recruiter
